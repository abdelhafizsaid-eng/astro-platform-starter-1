import React, { useState, useRef } from 'react';
import { Upload, Eye, Link2, X, Plus } from 'lucide-react';

export default function GiftCardCreator() {
  const [selectedCard, setSelectedCard] = useState(0);
  const [toName, setToName] = useState('');
  const [message, setMessage] = useState('');
  const [fromName, setFromName] = useState('');
  const [mediaUrl, setMediaUrl] = useState('');
  const [showPreview, setShowPreview] = useState(false);
  const [showAdminPanel, setShowAdminPanel] = useState(false);
  const [cards, setCards] = useState([
    {
      id: 0,
      name: 'Graduation',
      price: '50 LE',
      image: null,
      emoji: '🎓',
      bgColor: 'bg-yellow-50'
    },
    {
      id: 1,
      name: 'Umrah Mubarka',
      price: '50 LE',
      image: null,
      emoji: '🕌',
      bgColor: 'bg-gray-50'
    },
    {
      id: 2,
      name: 'Standard',
      price: '50 LE',
      image: null,
      emoji: '🌸',
      bgColor: 'bg-pink-50'
    }
  ]);

  const fileInputRef = useRef(null);
  const [editingCardId, setEditingCardId] = useState(null);

  const suggestedMessages = [
    "Cheers to you and all your hard work! May your future be bright and filled with endless opportunities.",
    "Congratulations on this amazing achievement! Wishing you all the best in your next chapter.",
    "So proud of everything you've accomplished. Here's to your bright future ahead!"
  ];

  const handlePreview = () => {
    setShowPreview(true);
  };

  const handleImageUpload = (e, cardId) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        setCards(cards.map(card => 
          card.id === cardId ? { ...card, image: event.target.result } : card
        ));
      };
      reader.readAsDataURL(file);
    }
  };

  const handleAddCard = () => {
    const newId = Math.max(...cards.map(c => c.id)) + 1;
    setCards([...cards, {
      id: newId,
      name: 'New Card',
      price: '50 LE',
      image: null,
      emoji: '🎁',
      bgColor: 'bg-blue-50'
    }]);
  };

  const handleDeleteCard = (cardId) => {
    if (cards.length > 1) {
      setCards(cards.filter(card => card.id !== cardId));
      if (selectedCard === cardId) {
        setSelectedCard(cards[0].id);
      }
    }
  };

  const handleUpdateCard = (cardId, field, value) => {
    setCards(cards.map(card => 
      card.id === cardId ? { ...card, [field]: value } : card
    ));
  };

  const bgColors = [
    'bg-yellow-50', 'bg-pink-50', 'bg-blue-50', 'bg-green-50', 
    'bg-purple-50', 'bg-red-50', 'bg-indigo-50', 'bg-gray-50'
  ];

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-white to-pink-50 py-8 px-4">
      <div className="max-w-4xl mx-auto">
        {/* Admin Toggle Button */}
        <button
          onClick={() => setShowAdminPanel(!showAdminPanel)}
          className="mb-4 bg-gray-800 hover:bg-gray-900 text-white px-6 py-2 rounded-lg text-sm font-medium transition-colors"
        >
          {showAdminPanel ? 'Hide' : 'Show'} Admin Panel
        </button>

        {/* Admin Panel */}
        {showAdminPanel && (
          <div className="bg-gray-800 text-white rounded-2xl p-6 mb-6 shadow-xl">
            <h2 className="text-xl font-bold mb-4">Card Management Panel</h2>
            <div className="space-y-4">
              {cards.map((card) => (
                <div key={card.id} className="bg-gray-700 rounded-lg p-4">
                  <div className="flex items-start gap-4">
                    <div className="flex-shrink-0">
                      <div className={`w-24 h-32 ${card.bgColor} rounded-lg flex items-center justify-center overflow-hidden`}>
                        {card.image ? (
                          <img src={card.image} alt={card.name} className="w-full h-full object-cover" />
                        ) : (
                          <span className="text-4xl">{card.emoji}</span>
                        )}
                      </div>
                      <button
                        onClick={() => {
                          setEditingCardId(card.id);
                          fileInputRef.current?.click();
                        }}
                        className="w-full mt-2 bg-purple-600 hover:bg-purple-700 text-white text-xs py-1 rounded transition-colors"
                      >
                        Upload Image
                      </button>
                      {card.image && (
                        <button
                          onClick={() => handleUpdateCard(card.id, 'image', null)}
                          className="w-full mt-1 bg-red-600 hover:bg-red-700 text-white text-xs py-1 rounded transition-colors"
                        >
                          Remove Image
                        </button>
                      )}
                    </div>
                    <div className="flex-1 space-y-3">
                      <div>
                        <label className="block text-xs font-medium mb-1">Card Name</label>
                        <input
                          type="text"
                          value={card.name}
                          onChange={(e) => handleUpdateCard(card.id, 'name', e.target.value)}
                          className="w-full px-3 py-2 bg-gray-600 border border-gray-500 rounded text-sm focus:outline-none focus:border-purple-400"
                        />
                      </div>
                      <div>
                        <label className="block text-xs font-medium mb-1">Price</label>
                        <input
                          type="text"
                          value={card.price}
                          onChange={(e) => handleUpdateCard(card.id, 'price', e.target.value)}
                          className="w-full px-3 py-2 bg-gray-600 border border-gray-500 rounded text-sm focus:outline-none focus:border-purple-400"
                        />
                      </div>
                      <div>
                        <label className="block text-xs font-medium mb-1">Emoji (if no image)</label>
                        <input
                          type="text"
                          value={card.emoji}
                          onChange={(e) => handleUpdateCard(card.id, 'emoji', e.target.value)}
                          className="w-full px-3 py-2 bg-gray-600 border border-gray-500 rounded text-sm focus:outline-none focus:border-purple-400"
                        />
                      </div>
                      <div>
                        <label className="block text-xs font-medium mb-1">Background Color</label>
                        <select
                          value={card.bgColor}
                          onChange={(e) => handleUpdateCard(card.id, 'bgColor', e.target.value)}
                          className="w-full px-3 py-2 bg-gray-600 border border-gray-500 rounded text-sm focus:outline-none focus:border-purple-400"
                        >
                          {bgColors.map(color => (
                            <option key={color} value={color}>{color}</option>
                          ))}
                        </select>
                      </div>
                    </div>
                    <button
                      onClick={() => handleDeleteCard(card.id)}
                      disabled={cards.length === 1}
                      className="p-2 bg-red-600 hover:bg-red-700 disabled:bg-gray-600 disabled:cursor-not-allowed rounded transition-colors"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              ))}
              <button
                onClick={handleAddCard}
                className="w-full bg-purple-600 hover:bg-purple-700 text-white py-3 rounded-lg flex items-center justify-center gap-2 transition-colors"
              >
                <Plus className="w-5 h-5" />
                Add New Card
              </button>
            </div>
            <input
              ref={fileInputRef}
              type="file"
              accept="image/*"
              onChange={(e) => handleImageUpload(e, editingCardId)}
              className="hidden"
            />
          </div>
        )}

        {/* Progress Steps */}
        <div className="flex items-center justify-center mb-12">
          <div className="flex items-center space-x-4">
            <div className="flex flex-col items-center">
              <div className="w-12 h-12 bg-purple-600 text-white rounded-full flex items-center justify-center mb-2">
                <span className="text-lg">🌸</span>
              </div>
              <span className="text-xs text-purple-600 font-medium">Card & QR</span>
            </div>
            <div className="w-16 h-0.5 bg-gray-300"></div>
            <div className="flex flex-col items-center">
              <div className="w-12 h-12 bg-gray-200 text-gray-500 rounded-full flex items-center justify-center mb-2">
                <span className="text-lg">📦</span>
              </div>
              <span className="text-xs text-gray-500">Shipping details</span>
            </div>
            <div className="w-16 h-0.5 bg-gray-300"></div>
            <div className="flex flex-col items-center">
              <div className="w-12 h-12 bg-gray-200 text-gray-500 rounded-full flex items-center justify-center mb-2">
                <span className="text-lg">💳</span>
              </div>
              <span className="text-xs text-gray-500">Payment</span>
            </div>
          </div>
        </div>

        {/* Card Selection */}
        <div className="bg-white rounded-2xl shadow-lg p-8 mb-6">
          <h2 className="text-2xl font-bold text-center text-gray-800 mb-6">Choose Card</h2>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
            {cards.map((card) => (
              <button
                key={card.id}
                onClick={() => setSelectedCard(card.id)}
                className={`relative rounded-xl p-4 transition-all ${
                  selectedCard === card.id
                    ? 'ring-4 ring-purple-500 shadow-xl'
                    : 'ring-2 ring-gray-200 hover:ring-purple-300'
                } ${card.bgColor}`}
              >
                <div className="aspect-[3/4] flex items-center justify-center mb-3 overflow-hidden rounded">
                  {card.image ? (
                    <img src={card.image} alt={card.name} className="w-full h-full object-cover" />
                  ) : (
                    <span className="text-6xl">{card.emoji}</span>
                  )}
                </div>
                <div className="text-center">
                  <h3 className="font-semibold text-gray-800">{card.name}</h3>
                  <p className="text-sm text-purple-600 font-medium">{card.price}</p>
                </div>
                {selectedCard === card.id && (
                  <div className="absolute top-2 right-2 w-6 h-6 bg-purple-600 rounded-full flex items-center justify-center">
                    <svg className="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" />
                    </svg>
                  </div>
                )}
              </button>
            ))}
          </div>
        </div>

        {/* Message Section */}
        <div className="bg-white rounded-2xl shadow-lg p-8 mb-6">
          <h2 className="text-xl font-bold text-gray-800 mb-6">Type Your Feelings....</h2>
          
          <div className="space-y-4">
            <div>
              <label className="block text-sm font-medium text-gray-600 mb-2">To</label>
              <input
                type="text"
                value={toName}
                onChange={(e) => setToName(e.target.value)}
                placeholder="Recipient's name"
                className="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-purple-500 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <div className="flex justify-between items-center mb-2">
                <label className="block text-sm font-medium text-gray-600">Message</label>
                <button 
                  onClick={() => setMessage(suggestedMessages[0])}
                  className="text-xs text-purple-600 hover:text-purple-700 font-medium"
                >
                  Try Flowrista Messages
                </button>
              </div>
              <textarea
                value={message}
                onChange={(e) => setMessage(e.target.value)}
                placeholder="Cheers to you and all your hard work! May your future be bright and filled with endless opportunities."
                rows="4"
                className="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-purple-500 focus:outline-none transition-colors resize-none"
              />
              <p className="text-xs text-gray-500 mt-1">Don't know what to say?</p>
            </div>

            <div>
              <label className="block text-sm font-medium text-gray-600 mb-2">From</label>
              <input
                type="text"
                value={fromName}
                onChange={(e) => setFromName(e.target.value)}
                placeholder="Your name"
                className="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-purple-500 focus:outline-none transition-colors"
              />
            </div>
          </div>
        </div>

        {/* Media Upload Section */}
        <div className="bg-white rounded-2xl shadow-lg p-8 mb-6">
          <h2 className="text-xl font-bold text-gray-800 mb-4">Express your emotions, creatively.</h2>
          
          <div className="space-y-4">
            <div className="flex items-center space-x-2">
              <Link2 className="w-5 h-5 text-gray-400" />
              <input
                type="url"
                value={mediaUrl}
                onChange={(e) => setMediaUrl(e.target.value)}
                placeholder="Paste a link to a song, image or video"
                className="flex-1 px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-purple-500 focus:outline-none transition-colors"
              />
            </div>

            <div className="relative">
              <button className="w-full bg-purple-100 hover:bg-purple-200 text-purple-700 font-medium py-4 px-4 rounded-lg flex items-center justify-center space-x-2 transition-colors">
                <Upload className="w-5 h-5" />
                <span>Upload a song, image or video</span>
              </button>
              <p className="text-xs text-gray-500 mt-2">Max attached file size is 30 MB</p>
            </div>

            <p className="text-xs text-gray-500 text-center">
              All media will be exported as QR Code on the card
            </p>
          </div>
        </div>

        {/* Preview Button */}
        <button
          onClick={handlePreview}
          className="w-full bg-white hover:bg-gray-50 border-2 border-gray-300 text-gray-700 font-semibold py-4 px-6 rounded-lg flex items-center justify-center space-x-2 transition-colors shadow-md"
        >
          <Eye className="w-5 h-5" />
          <span>Preview Gift Card</span>
        </button>

        {/* Continue Button */}
        <button className="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-4 px-6 rounded-lg mt-4 transition-colors shadow-lg">
          Continue to Shipping
        </button>

        {/* Preview Modal */}
        {showPreview && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50" onClick={() => setShowPreview(false)}>
            <div className="bg-white rounded-2xl p-8 max-w-md w-full" onClick={(e) => e.stopPropagation()}>
              <h3 className="text-2xl font-bold text-center mb-6">Gift Card Preview</h3>
              <div className={`${cards.find(c => c.id === selectedCard)?.bgColor} rounded-xl p-6 mb-4 aspect-[3/4] flex flex-col justify-between overflow-hidden`}>
                <div className="text-center mb-4">
                  {cards.find(c => c.id === selectedCard)?.image ? (
                    <img 
                      src={cards.find(c => c.id === selectedCard)?.image} 
                      alt="Card" 
                      className="w-full h-48 object-cover rounded-lg"
                    />
                  ) : (
                    <span className="text-6xl">{cards.find(c => c.id === selectedCard)?.emoji}</span>
                  )}
                </div>
                <div className="bg-white bg-opacity-90 rounded-lg p-4 text-sm">
                  <p className="font-semibold mb-2">To: {toName || 'Recipient'}</p>
                  <p className="text-gray-700 mb-2 italic">{message || 'Your message here...'}</p>
                  <p className="font-semibold text-right">From: {fromName || 'Sender'}</p>
                </div>
              </div>
              <button
                onClick={() => setShowPreview(false)}
                className="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 rounded-lg transition-colors"
              >
                Close Preview
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
